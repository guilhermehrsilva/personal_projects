# 1. Usar uma imagem oficial e leve do Python
FROM python:3.10-slim

# 2. Definir o diretório de trabalho dentro do contentor
WORKDIR /app

# Instalar dependências de sistema (como libgomp1) para suportar LightGBM / XGBoost
RUN apt-get update && apt-get install -y libgomp1 && rm -rf /var/lib/apt/lists/*

# 3. Copiar o ficheiro de dependências e instalar
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4. Copiar o código da API e os ficheiros do modelo (.pkl)
COPY api_scoring.py .
COPY *.pkl ./

# 5. Expor a porta que a API vai usar
EXPOSE 8080

# 6. Comando para arrancar o servidor quando o contentor iniciar
CMD ["uvicorn", "api_scoring:app", "--host", "0.0.0.0", "--port", "8080"]